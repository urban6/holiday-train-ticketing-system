# WAS 인스턴스의 /etc/waiting/env 로 복사해 채운다.
#
#   sudo install -m 640 -o root -g waiting env.example /etc/waiting/env
#   sudo vi /etc/waiting/env
#
# init-db.sh를 쓰면 이 파일을 손으로 채울 일이 없다 — 롤·데이터베이스를 만들고
# /etc/waiting/env까지 같은 권한으로 써 준다. 아래는 그 결과물의 형태다.
#
# 이 파일(env.example)만 커밋한다. 채운 env는 .gitignore에 있다.
#
# 여기 있는 넷과 QUEUE_SCHEDULER_ENABLED(다섯째, WAS를 다중화할 때만 쓰는 배포 토폴로지
# 값)가 환경마다 바뀌는 값 전부다. queue.* 튜닝값은 여기 두지 않는다 —
# application.yml이 유일한 진실 원천이고, 측정 중에 바꿀 때는 명령행 인자를 쓴다.
#
# 맨 아래 Kafka 세 줄은 그 원칙의 예외처럼 보이지만 아니다. 셋 다 "이 인스턴스가 무엇을
# 맡는가"이지 큐를 어떻게 굴릴지가 아니라서, QUEUE_SCHEDULER_ENABLED와 같은 칸에 있다.

# Redis EC2의 프라이빗 IP. 퍼블릭 IP를 쓰면 트래픽이 VPC 밖으로 나갔다 들어온다.
REDIS_HOST=10.0.1.30

# RDS 엔드포인트. 콘솔의 "엔드포인트 및 포트"에서 그대로 복사한다.
# 로컬은 5433이지만 RDS는 5432다 — 로컬 포트를 비켜 놓은 이유가 여기엔 없다.
DB_URL=jdbc:postgresql://<rds-endpoint>:5432/ticketing

# 애플리케이션 롤. RDS 마스터(기본 postgres)가 아니다 —
# 마스터를 넣으면 앱이 rds_superuser 권한으로 돌게 된다. init-db.sh가 이 롤을 만든다.
DB_USERNAME=ticketing

# 위 롤의 비밀번호. 비워 두면 application.yml의 로컬 기본값이 쓰이고,
# RDS가 그걸 거부하므로 기동 시점에 실패한다.
DB_PASSWORD=

# 이 인스턴스에서 승격·회수 스케줄러를 돌릴지. WAS가 1대뿐이면 이 줄 자체를 빼도 된다
# (기본값 true). WAS를 다중화할 때는 정확히 1대만 남기고 나머지는 false로 채운다 —
# 자세한 이유는 application.yml의 queue.scheduler-enabled 주석 참고.
QUEUE_SCHEDULER_ENABLED=true

# ── Kafka 경유 진입 (queue.enqueue-via-kafka) ──────────────────────────────
#
# 아래 셋은 Kafka를 거치는 측정에서만 쓴다. 도입 전 경로를 그대로 재려면 세 줄을
# 지우는 것이 아니라 QUEUE_ENQUEUE_VIA_KAFKA만 false로 둔다 — 그러면 나머지 둘이
# 틀려도 읽히지 않아, 같은 jar·같은 env로 플래그만 바꿔 전후를 잰다는 전제가 지켜진다.

# 브로커 EC2의 프라이빗 IP. REDIS_HOST와 같은 이유로 퍼블릭을 쓰지 않는다.
# 브로커 쪽 advertised listener도 같은 주소여야 한다 — 어긋나면 기동은 멀쩡하고
# produce만 조용히 타임아웃된다(provision.sh의 kafka 역할이 이걸 맞춰 준다).
KAFKA_BOOTSTRAP_SERVERS=10.0.1.40:9092

# 진입을 Kafka에 넘길지. 이 한 줄이 전후 비교의 스위치다.
QUEUE_ENQUEUE_VIA_KAFKA=true

# 이 인스턴스가 Redis에 넣는 초당 상한.
#
# application.yml의 60000은 WAS 1대 기준이다. 상한이 JVM 안에서만 지켜지므로
# 다중화하면 Redis가 받는 실효 유입률이 대수만큼 곱해진다 — 8대에 60000을 그대로 두면
# 480,000/s가 되어 Redis 한계(약 140,000)의 세 배를 넘고, 상한이 한 번도 걸리지 않는다.
# 그러면 "Kafka를 켰는데 아무 차이가 없다"는 결과가 나오는데 그건 Kafka가 아니라
# 이 줄을 빠뜨린 결과다.
#
#   전체 예산 60000 ÷ WAS 대수
#     1대 = 60000 · 2대 = 30000 · 8대 = 7500
#
# 전체 예산 60000의 근거는 application.yml의 queue.kafka.ingest-per-second 주석.
QUEUE_KAFKA_INGEST_PER_SECOND=7500
