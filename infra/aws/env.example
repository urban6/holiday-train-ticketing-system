# WAS 인스턴스의 /etc/waiting/env 로 복사해 채운다.
#
#   sudo install -m 640 -o root -g waiting env.example /etc/waiting/env
#   sudo vi /etc/waiting/env
#
# init-db.sh를 쓰면 이 파일을 손으로 채울 일이 없다 — 롤·데이터베이스를 만들고
# /etc/waiting/env까지 같은 권한으로 써 준다. 아래는 그 결과물의 형태다.
#
# 이 파일(env.example)만 커밋한다. 채운 env는 .gitignore에 있다.
#
# 여기 있는 넷이 환경마다 바뀌는 값 전부다. queue.* 튜닝값은 여기 두지 않는다 —
# application.yml이 유일한 진실 원천이고, 측정 중에 바꿀 때는 명령행 인자를 쓴다.

# Redis EC2의 프라이빗 IP. 퍼블릭 IP를 쓰면 트래픽이 VPC 밖으로 나갔다 들어온다.
REDIS_HOST=10.0.1.30

# RDS 엔드포인트. 콘솔의 "엔드포인트 및 포트"에서 그대로 복사한다.
# 로컬은 5433이지만 RDS는 5432다 — 로컬 포트를 비켜 놓은 이유가 여기엔 없다.
DB_URL=jdbc:postgresql://<rds-endpoint>:5432/ticketing

# 애플리케이션 롤. RDS 마스터(기본 postgres)가 아니다 —
# 마스터를 넣으면 앱이 rds_superuser 권한으로 돌게 된다. init-db.sh가 이 롤을 만든다.
DB_USERNAME=ticketing

# 위 롤의 비밀번호. 비워 두면 application.yml의 로컬 기본값이 쓰이고,
# RDS가 그걸 거부하므로 기동 시점에 실패한다.
DB_PASSWORD=
