# provision.sh가 읽는 AWS 자원 ID. provision.env로 복사해 채운다.
#
#   cp provision.env.example provision.env
#   vi provision.env
#
# 이 파일(provision.env.example)만 커밋한다. 채운 provision.env는 .gitignore에 있다.

# Ubuntu 26.04 LTS (arm64) AMI ID. 리전마다 다르므로 콘솔의 "AMI 카탈로그"에서 확인하거나:
#   aws ec2 describe-images --owners 099720109477 \
#       --filters "Name=name,Values=ubuntu-noble-26.04-arm64-server-*" "Name=state,Values=available" \
#       --query 'sort_by(Images,&CreationDate)[-1].ImageId' --output text
AMI_ID=ami-xxxxxxxxxxxxxxxxx

# was 역할에만 쓸 이미지. 비워 두면 세 역할 모두 위 AMI_ID로 뜬다.
# 미리 구워 둔 WAS 이미지(Corretto·waiting.service 포함)가 있을 때만 채운다 —
# 그 이미지는 waiting.service가 enable돼 있어 redis·k6에 쓰면 안 된다.
#   WAS_AMI_ID=ami-xxxxxxxxxxxxxxxxx

# WAS·Redis·k6가 같은 VPC·AZ·서브넷에 있어야 한다(README "배치" 절 참고).
SUBNET_ID=subnet-xxxxxxxxxxxxxxxxx

# 이들이 공유하는 보안 그룹. README "보안 그룹" 절의 규칙(8080·6379·16379·5432 자기 참조)이
# 이미 걸려 있어야 한다 — provision.sh는 그룹을 만들지 않고 ID만 받아 쓴다.
# 16379는 클러스터 버스다. 6379만 열면 --cluster create가 형성 단계에서 멈춘다.
SECURITY_GROUP_ID=sg-xxxxxxxxxxxxxxxxx

# SSH(또는 SSM 대체 시 비워 둠) 키 페어 이름.
KEY_NAME=your-key-pair

# 인스턴스 타입은 provision.sh가 역할별 기본값을 갖고 있어 보통 적지 않는다.
# 스윕(large → xlarge → 2xlarge)을 돌릴 때만 덮는다.
#   WAS_INSTANCE_TYPE=c8g.large · REDIS_INSTANCE_TYPE=c8g.large
#   K6_INSTANCE_TYPE=c8g.2xlarge
#
# k6는 2xlarge가 기본이지만 실측에서 모자랐다 — 44,000 req/s에서 자체 CPU 99.3%로
# 포화했다. WAS를 여러 대 띄우는 런에서는 8xlarge로 덮는다.
#   K6_INSTANCE_TYPE=c8g.8xlarge

# Redis 노드의 maxmemory. 비워 두면 redis-cluster-aws.conf의 3gb를 쓴다.
#   REDIS_MAXMEMORY=3gb
